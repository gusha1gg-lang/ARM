# Шаблон systemd-службы ARM-OMK.
# Не копируйте вручную: путь, пользователь и python подставляет
# install_service.sh (он же кладёт файл в /etc/systemd/system/).
[Unit]
Description=ARM-OMK - справочник ТЭСК ТБД (Flask + SQLite)
# Инструкция: linux/УСТАНОВКА.md (в Documentation= путь с кириллицей systemd не принимает)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=HOME=@ROOT@
ExecStart=@PYTHON@ serve.py

# Порт 80 без прав root: служба получает только право занять привилегированный порт.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arm-omk

[Install]
WantedBy=multi-user.target
