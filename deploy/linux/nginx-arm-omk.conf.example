# Пример настройки nginx для ARM-OMK (вариант «nginx на 80, сайт на 5000»).
#
# Нужен, если порт 80 уже занят другим сайтом или если нельзя давать
# службе CAP_NET_BIND_SERVICE. Тогда:
#   1) в .env проекта:  HOST=127.0.0.1  и  PORT=5000
#      (иначе сайт будет слушать все интерфейсы напрямую);
#   2) sudo systemctl restart arm-omk
#   3) sudo cp linux/nginx-arm-omk.conf.example /etc/nginx/sites-available/arm-omk.conf
#      sudo ln -s /etc/nginx/sites-available/arm-omk.conf /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
#
# Для RHEL/Alma конфиг кладут в /etc/nginx/conf.d/arm-omk.conf.

server {
    listen 80;
    # listen [::]:80;          # при наличии IPv6

    server_name _;             # или DNS-имя сервера, например arm-omk.local

    # Картинки камер могут быть крупными.
    client_max_body_size 25m;

    access_log /var/log/nginx/arm-omk-access.log;
    error_log  /var/log/nginx/arm-omk-error.log;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
