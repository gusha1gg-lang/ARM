# Скопируйте этот файл в .env и при необходимости измените значения.
# .env НЕ коммитится в git.
# При первом запуске serve.py сам создаст .env и сгенерирует SECRET_KEY.

# Секретный ключ сессий. Сгенерируйте случайную строку:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-random-string

# Путь к файлу SQLite (относительно корня проекта)
DATABASE_PATH=instance/asutp.db

# Папка для загружаемых изображений камер (относительно корня проекта)
UPLOAD_FOLDER=uploads

# Хост и порт. 127.0.0.1 — только этот компьютер,
# 0.0.0.0 — доступ из локальной сети (нужно для сервера).
HOST=127.0.0.1
PORT=5000

# Режим отладки (1 — включён, 0 — выключен). Для рабочего режима 0.
DEBUG=0
